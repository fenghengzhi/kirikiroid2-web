{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krkr2-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Worker 代码先跑，未命中路由的请求才交给静态资源。
    // /play/* 与 /admin* 需要 Worker 改写目标 HTML，所以不能让资源层抢先响应。
    "run_worker_first": true
  },

  "observability": { "enabled": true },

  "d1_databases": [
    {
      // binding 必须是 DB —— worker/ 里用的是 env.DB，
      // 不是 wrangler create 建议的 krkr2_games
      "binding": "DB",
      "database_name": "krkr2-games",
      "database_id": "f60c4ae0-6a73-4bfb-bb41-d600eb3403da",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "516531dd4ff84e7ab81cb3e190160602"
    }
  ],

  // 引擎大文件（index.wasm / assets.zip）。由 build-web.yml 在编译后传上来，
  // Worker 经 /engine/* 同源读出（见 worker/engine.js）。
  //
  // 走同源而不是让浏览器直连 R2 公开域名，是为了免掉跨源隔离那一整套：
  // 页面开着 COEP: require-corp，跨源资源必须自己发 CORP + CORS 才加载得了。
  // 同源就一个头都不用配。
  //
  // 没建桶也不影响其余功能：/engine/* 会返回 503 并说明要跑什么命令，
  // 画廊、后台、本地文件播放都照常。
  "r2_buckets": [
    {
      "binding": "ENGINE",
      "bucket_name": "krkr2-engine"
    }
  ]

  // Secrets（不写在此文件，用 wrangler secret put 设置）：
  //   ADMIN_PASSWORD_HASH   pbkdf2$<iters>$<b64salt>$<b64hash>
  //                         用 npm run hash-password '你的密码' 生成
  //   SESSION_SECRET        openssl rand -base64 32
}
