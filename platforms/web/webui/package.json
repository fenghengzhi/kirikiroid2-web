{
  "name": "krkr2-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/gen-sw.js",
    "preview": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply krkr2-games --local",
    "db:remote": "wrangler d1 migrations apply krkr2-games --remote",
    "hash-password": "node scripts/hash-password.js",
    "test": "node scripts/smoke-test.mjs && node scripts/offline-test.mjs && node scripts/sw-api-test.mjs && node scripts/savespace-test.mjs && node scripts/mobile-toolbar-test.mjs",
    "deploy:local": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "puppeteer-core": "^25.5.0",
    "vite": "^6.0.7",
    "wrangler": "^4.34.0"
  },
  "engines": {
    "node": ">=22"
  }
}
